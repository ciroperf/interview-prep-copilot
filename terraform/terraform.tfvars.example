# Copia in terraform.tfvars e adatta. terraform.tfvars e' in .gitignore.
#
# I default nel codice sono gia' quelli consigliati: per un primo deploy basta
# togliere il commento a budget_alert_email e lasciare tutto il resto com'e'.

# --- L'unica cosa davvero da compilare -------------------------------------
# budget_alert_email = "tu@esempio.it"

# --- Obbligatorio se non usi ARM_SUBSCRIPTION_ID ---------------------------
# subscription_id = "00000000-0000-0000-0000-000000000000"

# --- Identita' del progetto (default: ipc / prod / swedencentral) ----------
# name_prefix = "ipc"
# environment = "prod"
# location    = "swedencentral"

# Per usare un resource group che hai gia':
# create_resource_group = false
# resource_group_name   = "rg-mio-esistente"

# --- AI --------------------------------------------------------------------
# Default: gpt-5-mini con reasoning_effort = "low". Ragiona, quindi va molto
# meglio di gpt-4o-mini su revisione del CV e del codice, ma costa una frazione
# del modello pieno.
#
# Per vedere cosa e' davvero deployabile nella tua regione:
#   .\scripts\list-models.ps1 -Location swedencentral     (Windows)
#   ./scripts/list-models.sh swedencentral                  (macOS/Linux)
# Guida alla scelta: docs/modelli.md
#
# ai_model_name       = "gpt-5-mini"
# ai_model_version    = "2025-08-07"
# ai_deployment_sku   = "GlobalStandard"      # controlla nell'elenco!
# ai_api_version      = "2025-01-01-preview"
# ai_reasoning_effort = "low"                 # low | medium | high
# ai_capacity         = 20                    # migliaia di token al minuto

# Per azzerare la spesa AI: l'app resta usabile con le euristiche.
# enable_ai = false

# --- Costi -----------------------------------------------------------------
# 0 = l'app si spegne quando non la usi (cold start di qualche secondo).
# min_replicas = 0
# max_replicas = 1
# monthly_budget_eur = 15

# --- Funzionalita' opzionali ------------------------------------------------
# Conserva i CV caricati su Blob Storage. Di default vengono letti e scartati.
# store_cv_files = true

# Esecuzione sul server del codice inviato dall'utente.
# NON attivarla su un'app raggiungibile da internet: vedi docs/sicurezza.md.
# enable_code_execution = false

# Dominio personalizzato per il frontend, oltre a quello della Static Web App.
# allowed_origins = ["https://prep.miodominio.it"]

# --- Immagine dell'API -----------------------------------------------------
# Il workflow "Deploy API" costruisce l'immagine su GitHub e la pubblica su
# GHCR: al primo apply lascia il default, ci pensa poi scripts/update-api.ps1.
# container_image = "ghcr.io/ciroperf/interview-prep-copilot-api:latest"

# IMPORTANTE se il repository su GitHub e' PRIVATO.
# Anche il package GHCR lo e', e Container Apps non puo' scaricarlo in anonimo.
# Hai due strade:
#
#   A) Package privato + credenziali (gratis).
#      GHCR NON supporta i token fine-grained: serve un token CLASSIC.
#      Apri https://github.com/settings/tokens/new?scopes=read:packages
#      (pagina "Tokens (classic)": un elenco piatto di caselle, senza la
#      sezione "Repository access") e spunta solo read:packages.
# registry_server   = "ghcr.io"
# registry_username = "ciroperf"
# registry_password = "ghp_..."     # finisce in un secret della Container App
#
#   B) Rendere pubblico il package.
#      Gratis e senza token, ma l'immagine contiene il codice sorgente Python:
#      su un repository privato equivale a pubblicarlo. Sconsigliata.
#
#   C) Azure Container Registry, circa 4,60 EUR/mese. LA PIU' SEMPLICE.
#      Privato, nessun token da gestire, e scripts/deploy.ps1 se ne accorge da
#      solo: usa "az acr build", che compila il sorgente dentro Azure. Niente
#      Docker in locale, niente GitHub Actions, niente PAT.
# create_container_registry = true
