# Copia in .env per lo sviluppo locale. Il file .env non va mai committato.

# --- Generale --------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO

# Codice di accesso condiviso. Vuoto in locale = API aperta.
ACCESS_CODE=

# --- Persistenza -----------------------------------------------------------
# json = file locali (default in sviluppo), azure_tables = Azure Table Storage
STORAGE_BACKEND=json
DATA_DIR=.data

# Solo con STORAGE_BACKEND=azure_tables:
# AZURE_STORAGE_ACCOUNT_NAME=stipcprodabcde
# oppure, per l'emulatore Azurite in locale:
# AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# --- AI (Azure AI Foundry) -------------------------------------------------
# Senza queste variabili l'app funziona lo stesso, con le euristiche
# deterministiche al posto del modello.
AZURE_OPENAI_ENDPOINT=
# In locale si usa la chiave; in Azure si lascia vuota e si va di managed identity.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# I modelli reasoning (o3, o4-mini, gpt-5) richiedono una preview piu' recente,
# per esempio 2025-01-01-preview. Vedi docs/modelli.md.
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# auto | standard | reasoning. Con auto la famiglia si deduce dal nome del
# deployment e si corregge da sola al primo errore dell'API.
AI_MODEL_FAMILY=auto
# Solo per i modelli reasoning: low | medium | high. Vuoto = default del modello.
AI_REASONING_EFFORT=low
# Budget di output per i reasoning: include i token di ragionamento, quindi
# deve essere piu' alto di quello dei modelli standard.
AI_REASONING_MAX_OUTPUT_TOKENS=16000

# --- Esecuzione del codice utente ------------------------------------------
# Vedi docs/security.md prima di attivarla.
ENABLE_CODE_EXECUTION=false

# --- Upload ----------------------------------------------------------------
STORE_CV_FILES=false
